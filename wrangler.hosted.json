{
  "name": "arcdrake-site-check",
  "main": "hosted/worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [{ "class_name": "ScannerContainer", "image": "./Dockerfile", "instance_type": "lite", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "SCANNER", "class_name": "ScannerContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScannerContainer"] }]
}
